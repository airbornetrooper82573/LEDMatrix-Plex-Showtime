{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Plex Showtime Configuration",
  "properties": {
    "enabled": {"type": "boolean", "default": true},
    "display_duration": {"type": "number", "default": 20, "minimum": 1, "maximum": 300},
    "plex_url": {"type": "string", "description": "Plex server URL, for example http://192.168.1.50:32400"},
    "plex_token": {"type": "string", "description": "Plex authentication token (X-Plex-Token)"},
    "show_playing": {"type": "boolean", "default": true},
    "now_playing_users": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": [], "uniqueItems": true, "description": "Optional allowlist for Now Playing. Enter Plex user display names/usernames or user IDs. Empty means all users are allowed."},
    "show_now_playing_user": {"type": "boolean", "default": false, "description": "Show the accepted Plex user name in the Now Playing metadata row."},
    "now_playing_user_prefix": {"type": "string", "default": "USER", "minLength": 1, "maxLength": 20, "description": "Label shown before the Plex user name when show_now_playing_user is enabled."},
    "show_recently_added": {"type": "boolean", "default": true},
    "show_recently_played": {"type": "boolean", "default": true},
    "show_library": {"type": "boolean", "default": true},
    "filter_movies": {"type": "boolean", "default": true},
    "filter_tv": {"type": "boolean", "default": true},
    "filter_music": {"type": "boolean", "default": false},
    "balanced_rotation": {"type": "boolean", "default": true, "description": "Balance non-live source selection and Recently Added movie/TV/music categories with round-robin rotation instead of weighting by pool size."},

    "recently_added_movies_limit": {"type": "integer", "default": 10, "minimum": 0, "maximum": 100},
    "recently_added_tv_limit": {"type": "integer", "default": 10, "minimum": 0, "maximum": 100},
    "recently_added_tv_shows_limit": {"type": "integer", "default": 10, "minimum": 0, "maximum": 100},
    "recently_added_tv_episodes_limit": {"type": "integer", "default": 10, "minimum": 0, "maximum": 100},
    "recently_added_music_limit": {"type": "integer", "default": 10, "minimum": 0, "maximum": 100},
    "suppress_recent_episode_duplicates": {"type": "boolean", "default": true},
    "recently_added_episodes_per_show": {"type": "integer", "default": 1, "minimum": 1, "maximum": 20},
    "resolve_recent_tv_to_episode": {"type": "boolean", "default": true},

    "recently_played_movies_limit": {"type": "integer", "default": 10, "minimum": 0, "maximum": 100},
    "recently_played_tv_limit": {"type": "integer", "default": 10, "minimum": 0, "maximum": 100},
    "recently_played_music_limit": {"type": "integer", "default": 10, "minimum": 0, "maximum": 100},

    "show_heading": {"type": "boolean", "default": true},
    "show_year": {"type": "boolean", "default": true},
    "show_summary": {"type": "boolean", "default": false},
    "layout": {"type": "string", "enum": ["auto", "marquee", "artwork_info", "full_artwork"], "default": "auto"},
    "artwork_mode": {"type": "string", "enum": ["auto", "poster", "background"], "default": "auto"},
    "prefer_series_artwork_for_tv": {"type": "boolean", "default": true, "description": "For TV episodes, prefer show-level poster/backdrop artwork from Plex when available."},
    "artwork_width": {"type": "integer", "default": 72, "minimum": 32, "maximum": 160},
    "accent_width": {"type": "integer", "default": 2, "minimum": 1, "maximum": 8},
    "title_font_size": {"type": "integer", "default": 11, "minimum": 6, "maximum": 18},
    "subtitle_font_size": {"type": "integer", "default": 7, "minimum": 5, "maximum": 12},
    "heading_font_size": {"type": "integer", "default": 6, "minimum": 5, "maximum": 10},

    "enable_title_scroll": {"type": "boolean", "default": true, "description": "Scroll media/show titles horizontally when they exceed the configured trigger percentage of the available title area."},
    "title_scroll_speed": {"type": "number", "default": 14, "minimum": 1, "maximum": 60},
    "title_scroll_pause": {"type": "number", "default": 1.25, "minimum": 0, "maximum": 10},
    "title_scroll_gap": {"type": "integer", "default": 28, "minimum": 8, "maximum": 128},
    "title_scroll_fps": {"type": "integer", "default": 15, "minimum": 5, "maximum": 30},
    "scroll_trigger_ratio": {"type": "number", "default": 0.85, "minimum": 0.5, "maximum": 1.0, "description": "Start title scrolling when text width exceeds this fraction of the available row width."},
    "enable_episode_scroll": {"type": "boolean", "default": true},
    "episode_scroll_speed": {"type": "number", "default": 14, "minimum": 1, "maximum": 60},
    "episode_scroll_pause": {"type": "number", "default": 1.25, "minimum": 0, "maximum": 10},
    "episode_scroll_gap": {"type": "integer", "default": 28, "minimum": 8, "maximum": 128},
    "episode_scroll_trigger_ratio": {"type": "number", "default": 0.70, "minimum": 0.4, "maximum": 1.0, "description": "Start TV episode-line scrolling when the subtitle reaches this fraction of the available width."},
    "tv_row_gap": {"type": "integer", "default": 1, "minimum": 0, "maximum": 4},
    "media_row_gap": {"type": "integer", "default": 1, "minimum": 0, "maximum": 4, "description": "Vertical pixel gap between heading, title, and subtitle for movies and other standard media."},

    "show_panel_dividers": {"type": "boolean", "default": false},
    "panel_width": {"type": "integer", "default": 64, "minimum": 16, "maximum": 256},
    "recent_count": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100},
    "live_priority": {"type": "boolean", "default": false}
  },
  "required": ["enabled", "plex_url", "plex_token"],
  "additionalProperties": false
}